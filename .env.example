# Theology AI Lab v4.1 - Local Edition Environment
# =================================================
# 이 파일을 .env로 복사하여 사용하세요.

# ─────────────────────────────────────────────────
# Local Library Paths
# ─────────────────────────────────────────────────
INBOX_DIR=./01_Library/inbox
ARCHIVE_DIR=./01_Library/archive
DB_PATH=./02_Brain/vector_db

# ─────────────────────────────────────────────────
# Optional AI API Keys
# ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=AIza...

# ─────────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────────
APP_TITLE=Theology AI Lab (Local)
RAG_MODEL=gemini-2.5-flash
RAG_MAX_TOKENS=4096
OBSIDIAN_VAULT=

# ─────────────────────────────────────────────────
# OCR Settings
# ─────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGES=deu+eng+grc+heb+kor
LOG_LEVEL=INFO
